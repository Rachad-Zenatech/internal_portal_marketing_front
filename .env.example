# ==============================================================================
# Marketing Portal - Frontend Environment Configuration
# ==============================================================================

# Backend API Base URL (FastAPI on port 8010)
VITE_API_BASE_URL=http://localhost:8010

# Observability slow request threshold (ms)
VITE_SLOW_REQUEST_MS=2000

# --- Native (Expo / React Native) ---
# Expo inlines EXPO_PUBLIC_* at bundle time. On the Android emulator, `npm run android`
# sets up `adb reverse` so localhost:8010 reaches this machine.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8010
EXPO_PUBLIC_MOBILE_APP_SCHEME=zenamarketing
